; One-shot SystemUI icon storage initializer, separate from init and app domains.
(type rodin_fod_icon)
(roletype r rodin_fod_icon)
(typeattributeset domain (rodin_fod_icon))
(typeattributeset coredomain (rodin_fod_icon))
(typeattributeset mlstrustedsubject (rodin_fod_icon))
(type rodin_fod_icon_exec)
(roletype object_r rodin_fod_icon_exec)
(typeattributeset file_type (rodin_fod_icon_exec))
(typeattributeset exec_type (rodin_fod_icon_exec))
(typeattributeset system_file_type (rodin_fod_icon_exec))
(typetransition init rodin_fod_icon_exec process rodin_fod_icon)
(allow init rodin_fod_icon (process (transition siginh rlimitinh)))
; Standard secure-exec transition: keep AT_SECURE enabled, without audit noise.
(dontaudit init rodin_fod_icon (process (noatsecure)))
(allow init rodin_fod_icon_exec (file (read open getattr execute map)))
(allow rodin_fod_icon init (process (sigchld)))
(allow rodin_fod_icon init (fd (use)))
(allow rodin_fod_icon rodin_fod_icon_exec (file (entrypoint read open getattr execute map)))
(allow rodin_fod_icon self (capability (chown fowner)))
(allow rodin_fod_icon null_device (chr_file (read write open getattr ioctl)))
(allow rodin_fod_icon system_data_root_file (dir (search getattr)))
(allow rodin_fod_icon system_userdir_file (dir (read open search getattr)))
(allow rodin_fod_icon system_data_file (dir (read open search getattr)))
(allow rodin_fod_icon packages_list_file (file (read open getattr)))
(allow rodin_fod_icon os_data_file (dir (read open search getattr setattr write add_name)))
(allow rodin_fod_icon os_data_file (file (create read write open getattr setattr relabelfrom relabelto)))
